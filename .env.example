# 24x7 Personal AI Assistant Environment Configuration Template

# --- App-wide model provider ---
# openai | gemini. Picks the default chat and background models and the models cognee
# uses for graph extraction and embeddings (all on that provider's key below).
# PRIMARY_PROVIDER/PRIMARY_MODEL and SECONDARY_PROVIDER/SECONDARY_MODEL still override.
AI_PROVIDER=openai

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
XAI_API_KEY=your_xai_grok_api_key_here
PRIMARY_MODEL=GPT-5.5
EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith Observability & Tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=24x7-personal-assistant

# --- Direct External API Providers ---
# Values belong in local .env only. The API/frontend must show redacted status only.
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_TEST_CHAT_ID=optional_safe_test_chat_id_here
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Provider-managed MCP tools ---
# Configure Tavily/DuckDuckGo Search, Google Calendar, and Gmail through .agent/mcp_config.json.
# WhatsApp and Telegram are direct API providers, not MCP providers.

# --- Memory & Context Parameters ---
MAX_MESSAGES_BEFORE_TRIM=10
TOKEN_TRIM_THRESHOLD=4000

# --- Long-Term Memory (cognee knowledge graph) ---
# One cognee graph holds all long-term memory. Worth-storing turns go to a per-session
# cognee session first and merge into the main graph after SESSION_IDLE_TIMEOUT minutes idle.
# cognee's LLM and embedding models follow AI_PROVIDER (OpenAI: gpt-4o-mini + text-embedding-3-small;
# Gemini: gemini-3.5-flash-lite + gemini-embedding-001) and use that provider's key.
COGNEE_ENABLED=true
MEMORY_STORAGE_ENABLED=true
MEMORY_RETRIEVAL_ENABLED=true
SESSION_IDLE_TIMEOUT=30
MEMORY_USER_ID=default_user
MEMORY_COGNEE_DATASET=ivo_memory
# Defaults to .agent/cognee
MEMORY_COGNEE_DATA_DIR=
# SUMMARIES (default: distilled facts) | CHUNKS (raw stored text) | GRAPH_COMPLETION | RAG_COMPLETION
# The completion types return context only (no cognee answer); the primary model answers.
MEMORY_COGNEE_SEARCH_TYPE=SUMMARIES
MEMORY_COGNEE_TOP_K=8
MEMORY_COGNEE_RECALL_TIMEOUT_SECONDS=8
MEMORY_COGNEE_RETRIEVAL_TOKEN_BUDGET=1500
# Optional cognee overrides (see cognee docs): LLM_PROVIDER, LLM_MODEL, EMBEDDING_PROVIDER, EMBEDDING_DIMENSIONS

# --- Jev (decision/routing model, any OpenAI-compatible endpoint) ---
# Decides per message whether to store and whether to retrieve long-term memory,
# and may escalate medium-risk tool calls to human approval. Unset = safe fallbacks
# (no storage; retrieval for non-trivial messages; no tool escalation).
# Example on Gemini (free tier): JEV_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
# with JEV_MODEL=gemini-3.5-flash-lite. JEV_API_KEY may stay empty for Google's or OpenAI's
# own endpoint; the matching GOOGLE_API_KEY / OPENAI_API_KEY is used.
JEV_ENDPOINT=
JEV_MODEL=
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=5
TOOL_JEV_ENABLED=true
