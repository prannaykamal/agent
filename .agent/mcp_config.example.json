{
  "mcpServers": {
    "search_tavily": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.1.3"],
      "env": {
        "TAVILY_API_KEY": "PASTE_TAVILY_KEY_HERE"
      }
    },
    "search_duckduckgo": {
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "env": {
        "DDG_SAFE_SEARCH": "MODERATE",
        "DDG_REGION": "wt-wt",
        "DDG_SEARCH_BACKEND": "auto"
      }
    },
    "google_calendar": {
      "enabled": false,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "src.mcp_gateway.calendar_local_mcp"],
      "oauth": {
        "clientId": "PASTE_GOOGLE_OAUTH_CLIENT_ID_HERE",
        "clientSecret": "PASTE_GOOGLE_OAUTH_CLIENT_SECRET_HERE"
      },
      "scopes": [
        "https://www.googleapis.com/auth/calendar.events",
        "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
      ]
    },
    "gmail": {
      "enabled": false,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "src.mcp_gateway.gmail_local_mcp"],
      "oauth": {
        "clientId": "PASTE_GOOGLE_OAUTH_CLIENT_ID_HERE",
        "clientSecret": "PASTE_GOOGLE_OAUTH_CLIENT_SECRET_HERE"
      },
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/gmail.compose",
        "https://www.googleapis.com/auth/gmail.send"
      ]
    }
  }
}
